<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Garimpo Scanner"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#111111" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use Escanear São Paulo para iniciar o radar automático."
        android:textSize="13sp"
        android:textColor="#666666"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/autoScanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escanear rápido — 12 restaurantes"
        android:textAllCaps="false" />

    <EditText
        android:id="@+id/urlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textSize="12sp"
        android:inputType="textUri"
        android:text="https://99app.com/99food/sao-paulo/nosso-pastel-jardim-colonia/5764608520268546182/"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/openButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Abrir"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Escanear página"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/garimpoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ver Garimpo"
            android:textAllCaps="false" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
